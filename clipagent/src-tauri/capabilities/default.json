{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ],
  "shell": {
    "open": [
      { "url": "http://localhost:*" },
      { "url": "https://yourdomain.com/*" }
    ]
  }
}
