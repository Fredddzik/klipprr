{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipagent",
  "version": "0.1.0",
  "identifier": "com.frederikhypky.clipagent",

  "build": {
    "frontendDist": "../ui/out",
    "devUrl": null
  },

  "app": {
    "withGlobalTauri": true,

    "security": {
      "csp": null
    },

    "windows": [
      {
        "label": "main",
        "title": "ClipAgent",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],

    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },

  "plugins": {
    "shell": {
      "open": true
    }
  },

  "bundle": {
    "resources": [
      "bin/yt-dlp",
      "bin/ffmpeg",
      "assets/*"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
